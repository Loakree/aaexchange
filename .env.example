# Copy to .env locally. Never commit the copied file.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://exchange_user:change-this-password@localhost:5432/exchange

# Set only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Optional until a licensed provider adapter is implemented.
# BETTING_PROVIDER_MODULE=server/providers/acme.mjs
# ACME_BASE_URL=https://sandbox.example.com
# ACME_CLIENT_ID=
# ACME_CLIENT_SECRET=
